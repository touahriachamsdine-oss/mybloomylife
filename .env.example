# MyBloom Life environment
#
# Copy this file to `.env.local` and fill in a real value before running.
#
# Get this from your Neon project:
#   Dashboard -> your project -> Connect -> "Connection string" (use the
#   `postgresql://` pooled URL from the Serverless driver tab), then paste it
#   below replacing the placeholder.
DATABASE_URL=postgresql://user:pass@ep-your-branch.region.aws.neon.tech/neondb?sslmode=require

# Optional: real email delivery for the OTP login/register code flow.
# RESEND_API_KEY=
# RESEND_FROM="MyBloom Life <onboarding@resend.dev>"